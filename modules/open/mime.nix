# category -> mime types it handles; categories become modules.open.<category> options
{
  html = [
    "text/html"
    "application/xhtml+xml"
  ];
  image = [
    "image/png"
    "image/jpeg"
    "image/gif"
    "image/webp"
  ];
  pdf = [ "application/pdf" ];
  video = [ "video/mp4" ];
  audio = [ "audio/mp3" ];
  directory = [ "inode/directory" ];
}
