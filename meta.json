      ]
    },
    "perseus": {
      "system": "x86_64-linux",
      "version": "26.05",
      "kernel": "latest",
      "gpu": "nvidia",
      "usernames": [
        "tester"
      ]
    }
  },
  "users": {
    "frost": {
      "version": "26.05",
