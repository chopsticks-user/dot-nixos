{
  "supported": [
    "x86_64-linux",
    "x86_64-darwin",
    "aarch64-linux",
    "aarch64-darwin"
  ],
  "directories": {
    "nixos": "$HOME/.config/nixos",
    "system": {
      "identity": "/etc/ssh/ssh_host_ed25519_key"
    },
    "home": {
      "identity": ".ssh/id_ed25519",
      "cache": ".cache",
      "config": ".config",
      "data": ".local/share",
      "state": ".local/state",
      "bin": ".local/bin",
      "documents": "documents",
      "download": "downloads",
      "projects": "projects",
      "boxes": "boxes",
      "media": "media",
      "pictures": "media/images",
      "music": "media/audio",
      "videos": "media/videos",
      "wallpapers": "media/images/wallpapers",
      "screenshots": "media/images/screenshots",
      "screencasts": "media/videos/screencasts",
      "desktop": ".local/share/.xdg-ignore",
      "templates": ".local/share/.xdg-ignore",
      "publicShare": ".local/share/.xdg-ignore"
    }
  },
  "hosts": {
    "andromeda": {
      "system": "x86_64-linux",
      "version": "26.05",
      "kernel": "testing",
      "gpu": "nvidia",
